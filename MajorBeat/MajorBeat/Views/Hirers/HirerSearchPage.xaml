<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MajorBeat.Views.Hirers.HirerSearchPage"
             xmlns:enums="clr-namespace:MajorBeat.Enums"
             xmlns:converters="clr-namespace:MajorBeat.Converters"
             x:Name="SearchPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">



    <ContentPage.Resources>
        <converters:GeneroToStringConverter x:Key="GeneroConverter" />
    </ContentPage.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>



        <Grid Grid.Row="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border StrokeShape="RoundRectangle 0 0 0 0"  BackgroundColor="#4F1271"  Margin="0,0,0,0" WidthRequest="408" HorizontalOptions="Start" HeightRequest="90">
                    <VerticalStackLayout Margin="0,0,0,0">
                        <Border StrokeShape="{Binding BarFormat}" BackgroundColor="{Binding BarBackground}" VerticalOptions="End" Margin="20,20,0,0" WidthRequest="300" HorizontalOptions="Start" HeightRequest="45" ZIndex="10">
                            <VerticalStackLayout>
                                <Entry  Grid.Row="0" x:Name="searchBar" Completed="searchBar_Completed"  Text="{Binding UserEntry}" Placeholder="Pesquisar..." BackgroundColor="#AE92BD" PlaceholderColor="{Binding PlaceholderColor}" WidthRequest="250" Margin="0,0,25,0" HorizontalOptions="Center" TextColor="{Binding TextColor}" Focused="searchBar_Focused" Unfocused="searchBar_Unfocused" />
                                <ImageButton Grid.Row="0" Source="{Binding Lupa}" HorizontalOptions="End" Margin="0,-35,-20,0" HeightRequest="23" Command="{Binding SearchCommand}" Clicked="SearchButton_Clicked"/>
                            </VerticalStackLayout>
                        </Border>
                        <ImageButton Grid.Row="0" Source="logoicone" HeightRequest="70" HorizontalOptions="End" VerticalOptions="Start" Margin="320,-55,0,0"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid>
                <Border IsVisible="{Binding RecentSearch}" StrokeShape="RoundRectangle 0 0 10 10" BackgroundColor="#E7E7E7" VerticalOptions="End" Margin="21,60,0,0" WidthRequest="300"  HeightRequest="{Binding RecentSearchHeight}" HorizontalOptions="Start" ZIndex="10" >
                    <VerticalStackLayout>
                        <Label Text="Pesquisas Recentes" TextColor="#4F1271" HorizontalOptions="Start" Margin="5,10,0,0"/>
                        <Image Source="searchline.png" HeightRequest="100" WidthRequest="150" Margin="135,-58,0,-40"/>

                        <CollectionView Margin="0,0,0,0"  IsVisible="{Binding BarVisibility}" ItemsSource="{Binding FilteredSearchs}" >
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout>
                                        <Button BackgroundColor="Transparent"  Text="{Binding .}" HorizontalOptions="Start" WidthRequest="150" Margin="0,2,0,2" TextColor="#4f1271" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </Grid>



        </Grid>


        <ScrollView Grid.Row="1" Margin="0,0,0,20" IsVisible="{Binding HirerNoSelect}">
            <VerticalStackLayout>

                

                <Grid HorizontalOptions="Center" Margin="0,30,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>






                    <Grid Grid.Row="1" x:Name="event1" Margin="0,0,200,0">
                        <ImageButton Source="axe.png"
                         HeightRequest="140"
                         Command="{Binding GeneroCommand}"
                         CommandParameter="{x:Static enums:NomeGenero.AXÉ}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="200,0,0,0" x:Name="event2" HorizontalOptions="End">
                        <ImageButton Source="blues.png"
                         HeightRequest="140"
                         Command="{Binding GeneroCommand}"
                         CommandParameter="{x:Static enums:NomeGenero.BLUES}" />
                    </Grid>

                    <Grid Grid.Row="2" x:Name="event3" Margin="0,20,200,0">
                        <ImageButton Source="classico.png"
                         HeightRequest="140"
                         Command="{Binding GeneroCommand}"
                         CommandParameter="{x:Static enums:NomeGenero.CLASSICO}" />
                    </Grid>

                    <Grid Grid.Row="2" x:Name="event4" Margin="200,20,0,0" HorizontalOptions="End">
                        <ImageButton Source="disco.png"
                         HeightRequest="140"
                         Command="{Binding GeneroCommand}"
                         CommandParameter="{x:Static enums:NomeGenero.DISCO}" />
                    </Grid>

                    <Grid Grid.Row="3" x:Name="event5" Margin="0,20,200,0">
                        <ImageButton Source="eletronico.png"
                         HeightRequest="140"
                         Command="{Binding GeneroCommand}"
                         CommandParameter="{x:Static enums:NomeGenero.ELETRONICO}" />
                    </Grid>

                    <Grid Grid.Row="3" x:Name="event6" Margin="200,20,0,0" HorizontalOptions="End">
                        <ImageButton Source="forro.png"
                         HeightRequest="140"
                         Command="{Binding GeneroCommand}"
                         CommandParameter="{x:Static enums:NomeGenero.FORRO}" />
                    </Grid>

                    <Grid Grid.Row="4" x:Name="event7" Margin="0,20,200,0">
                        <ImageButton Source="funk.png"
                         HeightRequest="140"
                         Command="{Binding GeneroCommand}"
                         CommandParameter="{x:Static enums:NomeGenero.FUNK}" />
                    </Grid>

                    <Grid Grid.Row="4" x:Name="event8" Margin="200,20,0,0" HorizontalOptions="End">
                        <ImageButton Source="gospel.png"
                         HeightRequest="140"
                         Command="{Binding GeneroCommand}"
                         CommandParameter="{x:Static enums:NomeGenero.GOSPEL}" />
                    </Grid>

                    <Grid Grid.Row="5" x:Name="event9" Margin="0,20,200,0">
                        <ImageButton Source="hiphop.png"
                         HeightRequest="140"
                         Command="{Binding GeneroCommand}"
                         CommandParameter="{x:Static enums:NomeGenero.RAP}" />
                    </Grid>

                    <Grid Grid.Row="5" x:Name="event10" Margin="200,20,0,0" HorizontalOptions="End">
                        <ImageButton Source="infantil.png"
                         HeightRequest="140"
                         Command="{Binding GeneroCommand}"
                         CommandParameter="{x:Static enums:NomeGenero.TRAP}" />
                    </Grid>

                    <Grid Grid.Row="6" x:Name="event11" Margin="0,20,200,0">
                        <ImageButton Source="jazz.png"
                         HeightRequest="140"
                         Command="{Binding GeneroCommand}"
                         CommandParameter="{x:Static enums:NomeGenero.JAZZ}" />
                    </Grid>

                    <Grid Grid.Row="6" x:Name="event12" Margin="200,20,0,0" HorizontalOptions="End">
                        <ImageButton Source="metal.png"
                         HeightRequest="140"
                         Command="{Binding GeneroCommand}"
                         CommandParameter="{x:Static enums:NomeGenero.METAL}" />
                    </Grid>

                    <Grid Grid.Row="7" x:Name="event13" Margin="0,20,200,0">
                        <ImageButton Source="pop.png"
                         HeightRequest="140"
                         Command="{Binding GeneroCommand}"
                         CommandParameter="{x:Static enums:NomeGenero.POP}" />
                    </Grid>

                    <Grid Grid.Row="7" x:Name="event14" Margin="200,20,0,0" HorizontalOptions="End">
                        <ImageButton Source="rock.png"
                         HeightRequest="140"
                         Command="{Binding GeneroCommand}"
                         CommandParameter="{x:Static enums:NomeGenero.ROCK}" />
                    </Grid>

                    <Grid Grid.Row="8" x:Name="event15" Margin="0,20,200,0">
                        <ImageButton Source="samba.png"
                         HeightRequest="140"
                         Command="{Binding GeneroCommand}"
                         CommandParameter="{x:Static enums:NomeGenero.SAMBA}" />
                     </Grid>

                    <Grid Grid.Row="8" x:Name="event16" Margin="200,20,0,0" HorizontalOptions="End">
                        <ImageButton Source="sertanejo.png"
                         HeightRequest="140"
                         Command="{Binding GeneroCommand}"
                         CommandParameter="{x:Static enums:NomeGenero.SERTANEJO}" />
                        </Grid>

                    <Grid Grid.Row="9" x:Name="event17" Margin="0,20,200,0">
                        <ImageButton Source="outro.png"
                             HeightRequest="140"
                             Command="{Binding GeneroCommand}"
                              />
                    </Grid>










                </Grid>
            </VerticalStackLayout>
        </ScrollView>








      


        <!-- Conteúdo principal Do EVENTO-->

        <Grid Grid.Row="1" IsVisible="{Binding NoMusics}">
            <Grid>
                <Button   HeightRequest="40" WidthRequest="100" CornerRadius="36" HorizontalOptions="Start"  VerticalOptions="Start" Margin="20,40,0,40" BackgroundColor="#e7e7e7" Command="{Binding BackGenreCommand}"></Button>
                <Label Text="Voltar" FontSize="18" FontAttributes="Bold" FontFamily="InterBold" TextColor="#4F1271" Margin="0,47,250,0" HorizontalOptions="Center"></Label>
                <Image Source="back.png" HeightRequest="20" Margin="-330,50,0,0" VerticalOptions="Start"   ZIndex="1"/>
            </Grid>
            <Label Text="Sem Musicos Disponiveis no Momento para este Gênero!" HorizontalOptions="Center" VerticalOptions="Center" FontSize="26" WidthRequest="420" Margin="70,-40,0,0" TextColor="#4F1271"/>
        </Grid>
        
        
        <ScrollView Grid.Row="1" IsVisible="{Binding IsSearch}">
            <VerticalStackLayout>

                <Grid>
                    <Button  x:Name="voltar" HeightRequest="40" WidthRequest="100" CornerRadius="36" HorizontalOptions="Start" Margin="20,40,0,40" BackgroundColor="#e7e7e7" Command="{Binding BackGenreCommand}"></Button>
                    <Label Text="Voltar" FontSize="18" FontAttributes="Bold" FontFamily="InterBold" TextColor="#4F1271" Margin="0,47,250,0" HorizontalOptions="Center"></Label>
                    <Image Source="back.png" HeightRequest="20" Margin="-330,0,0,0"   ZIndex="1"/>
                </Grid>


                <Label Text="RESULTADOS ENCCONTRADOS:" TextColor="#4F1271" FontAttributes="Bold" FontSize="20" HorizontalOptions="Start" Margin="20,50,0,0"/>


                <!-- Eventos -->
            
                    <CollectionView ItemsSource="{Binding Musicos}"  Margin="0,100,0,40" IsVisible="{Binding FindResults}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,-100,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                               

                                    <!-- Carousel de imagens -->
                                <CarouselView ItemsSource="{Binding BindingContext.EventPhoto, Source={x:Reference SearchPage}}" Position="{Binding BindingContext.ActualPosition, Source={x:Reference SearchPage}, Mode=TwoWay}">
                                    <CarouselView.ItemTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding .}" HeightRequest="600" Margin="0,10,0,0"/>
                                        </DataTemplate>
                                    </CarouselView.ItemTemplate>
                                </CarouselView>

                                <!-- Contador de imagens -->
                                <Border StrokeShape="RoundRectangle 10 10 0 0" Background="#4F1271" HeightRequest="25" WidthRequest="45" HorizontalOptions="End" VerticalOptions="Start" Margin="0,160,20,0">
                                    <Label Text="{Binding BindingContext.PhotoCounter, Source={x:Reference SearchPage}}" HorizontalTextAlignment="Center" TextColor="White" FontSize="15"/>
                                </Border>



                              

                                <!-- Informações do evento -->
                                <Border StrokeShape="RoundRectangle 0 0 5 5" BackgroundColor="#4F1271" WidthRequest="410" HorizontalOptions="End" VerticalOptions="End" HeightRequest="250" Margin="0,0,0,50">
                                    <VerticalStackLayout VerticalOptions="Center" HeightRequest="200" Margin="0,0,0,0">
                                        
                                        <Label Text="{Binding nome}" FontAttributes="Bold" FontSize="25" HorizontalOptions="Start" TextColor="#ffffff" Margin="20,100,0,20"/>


                                        <!--Generos Musicais-->
                                        <Grid>
                                            <CollectionView ItemsSource="{Binding nomeGeneros}" ItemsLayout="HorizontalList" Margin="0,5,0,0">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border StrokeShape="RoundRectangle 8,8,8,8" BackgroundColor="#FFFFFF" Margin="20,20,0,0" WidthRequest="100" HorizontalOptions="Start" HeightRequest="35">
                                                        <Label Text="{Binding ., Converter={StaticResource GeneroConverter}}" TextColor="#4F1271" HorizontalOptions="Center" FontSize="17" FontAttributes="Bold" Margin="0,0,0,0" />
                                                    </Border>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                        </Grid>
                                        
                                        <Grid>
                                            <Label Text="{Binding avaliacoes[0].nota}" TextColor="#ffffff" FontSize="27" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-122,50,0"/>
                                            <Image Source="eventstar.png" HeightRequest="30" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-120,10,0"/>
                                        </Grid>

                                    </VerticalStackLayout>
                                </Border>
                            
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                
            </VerticalStackLayout>
        </ScrollView>


       

















        <VerticalStackLayout Grid.Row="2">
            <Grid Grid.Row="1" BackgroundColor="#4F1271" Padding="10" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Botão 1 -->
                <Frame Grid.Column="0"
        WidthRequest="50" HeightRequest="50"
        CornerRadius="25"
        BackgroundColor="#AE92BD"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        HasShadow="True">
                    <ImageButton x:Name="home_page_btn" Source="home.png" WidthRequest="24" HeightRequest="24" Clicked="home_page_btn_Clicked" />
                </Frame>

                <!-- Botão 2 -->
                <Frame Grid.Column="1"
        WidthRequest="60" HeightRequest="60"
        CornerRadius="30"
        BackgroundColor="#783F8E"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        HasShadow="True">
                    <ImageButton x:Name="search_page_btn" Source="searchhome.png" WidthRequest="24" HeightRequest="24" />
                </Frame>

                <!-- Botão 3 -->
                <Frame Grid.Column="2"
        WidthRequest="50" HeightRequest="50"
        CornerRadius="25"
        BackgroundColor="#AE92BD"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        HasShadow="True">
                    <ImageButton x:Name="chat" Clicked="chat_Clicked"  Source="chathome.png" WidthRequest="24" HeightRequest="24" />
                </Frame>

                <Frame Grid.Column="3"
             WidthRequest="50" HeightRequest="50"
             CornerRadius="25"
             BackgroundColor="#AE92BD"
             HorizontalOptions="Center"
             VerticalOptions="Center"
             HasShadow="True">
                    <Image Source="calendar.png" WidthRequest="24" HeightRequest="24"/>
                </Frame>

                <Frame Grid.Column="4"
             WidthRequest="50" HeightRequest="50"
             CornerRadius="25"
             BackgroundColor="#AE92BD"
             HorizontalOptions="Center"
             VerticalOptions="Center"
             HasShadow="True">
                    <Image Source="profilehome.png" WidthRequest="24" HeightRequest="24"/>
                </Frame>
            </Grid>
        </VerticalStackLayout>

    </Grid>
</ContentPage>