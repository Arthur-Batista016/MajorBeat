<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MajorBeat.Views.Users.ChatPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <VerticalStackLayout Grid.Row="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border StrokeShape="RoundRectangle 0 0 10 10" BackgroundColor="#4F1271"  Margin="0,0,0,0" HorizontalOptions="Fill" HeightRequest="90">
                    <VerticalStackLayout Margin="0,0,0,0">
                        <Border StrokeShape="RoundRectangle 10 10 10 10" BackgroundColor="#AE92BD" VerticalOptions="End" Margin="20,20,0,0" WidthRequest="300" HorizontalOptions="Start" HeightRequest="45">
                            <VerticalStackLayout>
                                <Entry  Grid.Row="0" Placeholder="Pesquisar..." BackgroundColor="#AE92BD" PlaceholderColor="#FFFFFF" FontAttributes="Bold" WidthRequest="250" Margin="0,0,25,0" HorizontalOptions="Center" TextColor="White">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="PlaceholderColor" Value="White" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState Name="Focused">
                                                <VisualState.Setters>
                                                    <Setter Property="PlaceholderColor" Value="White" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Entry>
                                <Image Grid.Row="0" Source="lupainverted" HorizontalOptions="End" Margin="0,-35,20,0" HeightRequest="23"/>
                            </VerticalStackLayout>
                        </Border>
                        <ImageButton Grid.Row="0" Source="logoicone" HeightRequest="70" HorizontalOptions="End" VerticalOptions="Start" Margin="320,-55,0,0"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <CollectionView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="Black" WidthRequest="200">
                            <Label Text="Panelão do norte"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>



        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <CollectionView Margin="0,0,0,0"  IsVisible="{Binding HasContacts}" ItemsSource="{Binding Musicos}" >
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout>
                            <Image Grid.Row="0" Source="{Binding fotoPerfil}" HorizontalOptions="Start" HeightRequest="50" VerticalOptions="Center" Margin="20,105,0,0"/>
                            <Label Grid.Row="0" Text="{Binding nome}" HorizontalOptions="Start" Margin="100,-50,0,0" FontAttributes="Bold" TextColor="#4F1271"/>
                            <Label Grid.Row="0" Text="14:11" HorizontalOptions="End" Margin="0,-30,10,0" TextColor="#4F1271"/>
                            <Label Grid.Row="1" Text="Ultima mensagem aqui" HorizontalOptions="Center" Margin="10,20,55,0" TextColor="#4F1271"/>
                            <Button BackgroundColor="Transparent" HeightRequest="3000" Margin="0,-65,0,0"/>
                            <Image Source="chatline.png" HeightRequest="100"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            

        </Grid>

        <Grid Grid.Row="1" IsVisible="{Binding NoContacts}" >
            <Label Text="Você ainda não tem contatos adicionados." HorizontalOptions="Center" VerticalOptions="Center" TextColor="#783F8E" FontAttributes="Bold" HorizontalTextAlignment="Center" FontSize="23"/>
        </Grid>



























        <VerticalStackLayout Grid.Row="2">
            <Grid BackgroundColor="#4F1271" Padding="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Botões -->
                <Frame Grid.Column="0" WidthRequest="60" HeightRequest="60" CornerRadius="30" BackgroundColor="#783F8E" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="True">
                    <ImageButton x:Name="home_page_btn" Source="home.png" WidthRequest="24" HeightRequest="24"  />
                </Frame>

                <Frame Grid.Column="1" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="#AE92BD" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="True">
                    <ImageButton x:Name="search_page_btn" Source="searchhome.png" WidthRequest="24" HeightRequest="24"  />
                </Frame>

                <Frame Grid.Column="2" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="#AE92BD" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="True">
                    <Image Source="chathome.png" WidthRequest="24" HeightRequest="24"/>
                </Frame>

                <Frame Grid.Column="3" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="#AE92BD" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="True">
                    <Image Source="calendar.png" WidthRequest="24" HeightRequest="24"/>
                </Frame>

                <Frame Grid.Column="4" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="#AE92BD" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="True">
                    <ImageButton Source="profilehome.png" WidthRequest="24" HeightRequest="24"  />
                </Frame>
            </Grid>
        </VerticalStackLayout>

    </Grid>
    <!--fim do grid da pagina inteira-->

</ContentPage>